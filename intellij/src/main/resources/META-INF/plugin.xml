<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>net.typho.big_shot_lib</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Big Shot Lib</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.typho.net">The Typhothanian</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Warnings and inspections for the Big Shot minecraft modding library
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>com.intellij.java</depends>
    <depends>com.demonwav.minecraft-dev</depends>
    <depends optional="true" config-file="kotlin.xml">org.jetbrains.kotlin</depends>

    <resource-bundle>messages.BigShotLibBundle</resource-bundle>

    <actions>
        <action id="NewMixinAction"
                class="net.typho.big_shot_lib.intellij.mixin.NewMixinAction"
                text="Mixin"
                icon="net.typho.big_shot_lib.intellij.BigShotLibIcons.mixin">
            <add-to-group group-id="NewGroup"
                          anchor="after"
                          relative-to-action="Kotlin.NewFile"></add-to-group>
        </action>
    </actions>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <localInspection language="UAST"
                         bundle="messages.BigShotLibBundle"
                         key="inspection.messages.expected_immutable.references.display.name"
                         enabledByDefault="true"
                         groupBundle="messages.BigShotLibBundle"
                         level="WARNING"
                         implementationClass="net.typho.big_shot_lib.intellij.ExpectedImmutableInspection"></localInspection>
        <localInspection language="JSON"
                         bundle="messages.BigShotLibBundle"
                         key="inspection.messages.invalid_service.references.display.name"
                         enabledByDefault="true"
                         groupBundle="messages.BigShotLibBundle"
                         level="ERROR"
                         implementationClass="net.typho.big_shot_lib.intellij.services.InvalidNeoServiceInspection"></localInspection>

        <internalFileTemplate name="Mixin" id="mixin"></internalFileTemplate>
        <internalFileTemplate name="Accessor" id="accessor"></internalFileTemplate>

        <psi.referenceContributor implementation="net.typho.big_shot_lib.intellij.services.NeoServicesReferenceContributor"></psi.referenceContributor>
        <psi.referenceContributor implementation="net.typho.big_shot_lib.intellij.codecs.CodecLookupReferenceContributor"></psi.referenceContributor>
    </extensions>

</idea-plugin>
